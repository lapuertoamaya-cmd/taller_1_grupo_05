# (1.2) estimar modelo 1
modelo_1 <- lm(ln_salario_h ~ educacion + afqt_score + mujer + hispano + negro ,data=punto_1)
betas_m1 <- coef(modelo_1)
errores_robustos <- list(vcovHC(modelo_1, type = "HC1"))
summary(modelo_1)
coeftest(modelo_1, vcov = vcovHC(modelo_1, type = "HC1"))
modelsummary(
modelo_1,
vcov = errores_robustos,
stars = TRUE,                             # Añade los asteriscos de significancia (*, **, ***)
title = "Resultados de la Regresión OLS Robust",
output = "tabla_regresion.docx"           # R crea el archivo Word en tu carpeta de trabajo
)
