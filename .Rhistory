negro==1 ~ "Negro",
is.na(negro) & is.na(hispano) ~ NA_character_,
is.na(negro) | is.na(hispano) ~ NA_character_,
TRUE ~ "Otros"
),
no_ambos_padres_bio_c = case_when(no_ambos_padres_bio==1 ~ "1",
no_ambos_padres_bio==0 ~ "0")
))
# (1.5) diagramas de dispersion con heterogeneidades
punto_1 <- punto_1 %>%
mutate(raza=case_when(hispano==1 ~ "Hispano",
negro==1 ~ "Negro",
is.na(negro) & is.na(hispano) ~ NA_character_,
is.na(negro) | is.na(hispano) ~ NA_character_,
TRUE ~ "Otros"
),
no_ambos_padres_bio_c = case_when(no_ambos_padres_bio==1 ~ "1",
no_ambos_padres_bio==0 ~ "0")
)
