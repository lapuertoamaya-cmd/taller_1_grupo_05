training <- base_analisis %>%
filter(chunk %in% c(1:7))
test <- base_analisis %>%
filter(chunk %in% c(8:10))
estimacion_modelos <- function(X, train=TRUE) {
formula <- reformulate(termlabels=X, reponse=ln_ingreso_total)
if (train) {
modelo <- lm(formula, data=training)
}
else {
modelo <- lm(formula, data=test)
}
stargazer(modelo, type="latex")
}
# (5.1) modelo de edad incondicional
m1.1 <- c("edad","I(edad^2)")
estimacion_modelos(m1.1)
estimacion_modelos(m1.1, train=TRUE)
reformulate(c("edad","I(edad^2)"))
# (5.1) modelo de edad incondicional
m1.1 <- c("edad","ans_educ")
estimacion_modelos(m1.1)
reformulate(c("edad","I(edad^2)"), response=ln_ingreso_total)
reformulate(c("edad","I(edad^2)"), response=.data[[ln_ingreso_total]])
reformulate(c("edad","I(edad^2)"), response="ln_ingreso_total")
